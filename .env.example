# Required for every ChatGroq workflow
GROQ_API_KEY=your_groq_api_key_here

# Optional: enables the Alpha Vantage stock-price tool
ALPHAVANTAGE_API_KEY=your_alpha_vantage_api_key_here

# Optional: enables LangSmith tracing and observability
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=Conversational-AI-Agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=false

# Optional: only needed for higher Hugging Face Hub download limits or private models
# HF_TOKEN=your_huggingface_token_here
