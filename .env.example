# ═══════════════════════════════════════════════════════════════════════════
# Multi-Agent AI Research Chatbot — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.
#
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────────────────────────
# Groq API key — free tier available at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── OPTIONAL: Model selection ─────────────────────────────────────────────
# Default: openai/gpt-oss-20b  (free on Groq)
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_TEMPERATURE=0

# ── OPTIONAL: Database & Vector Storage ──────────────────────────────────
# Path to SQLite database file (relative or absolute)
# DB_PATH=chatbot.db
#
# Directory to store persistent FAISS vector indexes (isolated per user & thread)
# VECTOR_STORE_DIR=data/vector_stores
#
# To migrate to PostgreSQL, install langgraph-checkpoint-postgres
# and update core/memory.py to use AsyncPostgresSaver.
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot

# ── OPTIONAL: Alpha Vantage (stock prices) ────────────────────────────────
# Free tier: https://www.alphavantage.co/support/#api-key
# Without this key, the stock tool returns a clear error message.
# ALPHAVANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ── OPTIONAL: MCP server ──────────────────────────────────────────────────
# URL of your MCP-compatible tool server.
# The app starts normally even if this server is unreachable.
# MCP_SERVER_URL=http://127.0.0.1:8000/mcp
# MCP_ENABLED=true

# ── OPTIONAL: LangSmith tracing ───────────────────────────────────────────
# Observability and debugging. Free tier: https://smith.langchain.com
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=Multi-Agent-AI-Chatbot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_TRACING=false

# ── OPTIONAL: HuggingFace ─────────────────────────────────────────────────
# Only needed for higher download limits or private models.
# The public all-MiniLM-L6-v2 embedding model does not require a token.
# HF_TOKEN=your_huggingface_token_here

# ── OPTIONAL: App settings ────────────────────────────────────────────────
# LOG_LEVEL=INFO
# MAX_PDF_SIZE_MB=50
